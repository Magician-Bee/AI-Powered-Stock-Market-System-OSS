# Stock AI local configuration
# Copy this file to .env. Never commit the real .env file.

APP_NAME=股市 AI 生態系 MVP
APP_ENV=development
DATA_CATALOG_PATH=config/data_catalog.yaml

# Realtime market data
REALTIME_QUOTE_PROVIDER=twse_mis
FUGLE_MARKETDATA_API_KEY=
REALTIME_STREAM_CHANNELS=trades,books,candles

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_ACCESS_TOKEN=
LINE_TARGET_ID=

# Optional n8n Headless execution gateway. Start the local loopback-only
# executor with 啟動n8n執行層.command; both gateway values below are still
# required before an external automation may be published. Keep real values
# only in local .env.
N8N_AUTOMATION_GATEWAY_URL=
N8N_AUTOMATION_GATEWAY_TOKEN=
N8N_AUTOMATION_GATEWAY_TIMEOUT_SECONDS=15

# Open Stock AI configuration file and safety boundaries
OPEN_STOCK_AI_CONFIG=config/open_stock_ai.yaml
OPEN_STOCK_AI_MODE=paper
LIVE_TRADING_ENABLED=false
REQUIRE_HUMAN_CONFIRM=true
EXTERNAL_RUNTIME_CONNECTORS_ENABLED=false
BROKER_ACCOUNT_IMPORTS_ENABLED=false
EXTERNAL_CREDENTIALS_ENABLED=false
OPEN_STOCK_AI_SQLITE_PATH=output/open_stock_ai.sqlite

# Central RiskEngine overrides
MIN_CONFIDENCE=0.70
MAX_POSITION_SIZE_PCT=10
MAX_DAILY_LOSS_PCT=3
MAX_TOTAL_DRAWDOWN_PCT=15
MAX_SYMBOL_EXPOSURE_PCT=20
MAX_TOTAL_PAPER_EXPOSURE_PCT=100
MAX_INDUSTRY_EXPOSURE_PCT=45
REQUIRE_BACKTEST_PASSED=true

# Stock AI Agent Runtime
# Codex is the only enabled model provider. FinGPT and other local/external
# model processes are not downloaded, loaded, or started by the application.
STOCK_AI_AGENT_CONFIG=config/agent_runtime.yaml
STOCK_AI_AGENT_SETTINGS_PATH=output/agent_runtime_settings.json
STOCK_AI_AGENT_DRIVER=codex

# Persistent local Paper OMS
# These are explicit simulation assumptions, not broker or exchange fee claims.
OPEN_STOCK_AI_PAPER_ACCOUNT_ID=default-paper
OPEN_STOCK_AI_PAPER_BASE_CURRENCY=TWD
OPEN_STOCK_AI_PAPER_INITIAL_CASH=1000000
OPEN_STOCK_AI_PAPER_COMMISSION_BPS=0
OPEN_STOCK_AI_PAPER_SELL_TAX_BPS=0
OPEN_STOCK_AI_PAPER_SLIPPAGE_BPS=0
OPEN_STOCK_AI_PAPER_LOT_SIZE=1
